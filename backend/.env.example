JWT_SECRET=change_me_to_a_unique_secret_at_least_32_chars
RECEIPT_SECRET=change_me_to_another_unique_secret_32_chars
PORT=4000
GRPC_PORT=50051
NODE_ENV=development
CORS_ORIGINS=http://localhost:8080

# Firebase project ID used to verify signed Firebase ID tokens
FIREBASE_PROJECT_ID=

# json for local development; postgres for persistent hosted gameplay
DATA_DRIVER=json

# Supabase PostgreSQL: use DATABASE_URL from the Supabase Connect panel.
# Keep the URL private; do not commit real credentials.
DATABASE_URL=
PG_SSL=true

# Optional individual PostgreSQL connection fields if DATABASE_URL is not used
PG_HOST=
PG_PORT=5432
PG_DATABASE=postgres
PG_USER=postgres
PG_PASSWORD=

# Redis optional
REDIS_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379
