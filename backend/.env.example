JWT_SECRET=change_me_jwt_secret
RECEIPT_SECRET=change_me_receipt_secret
PORT=4000
GRPC_PORT=50051
NODE_ENV=development
CORS_ORIGINS=http://localhost:8080

# Firebase project ID used to verify signed Firebase ID tokens
FIREBASE_PROJECT_ID=

# json (local only), mysql, or postgres (Supabase)
DATA_DRIVER=json

# MySQL / MariaDB (when DATA_DRIVER=mysql)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=infinitwar
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_SSL=false

# PostgreSQL / Supabase (when DATA_DRIVER=postgres); keep credentials private
DATABASE_URL=

# Redis optional (enable for distributed locks/idempotency)
REDIS_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379